extends TestCase
## Bowman second-job fixtures (#166 QA #204), generated by the real seeded Henesys bot.
## Their _doc records the exact fixture-tool arguments and revision; restoration must retain skills, equipment and ammo.
## Reproduce with tools/character_fixture.gd --job=<310|320> --seed=1 --god --seconds=600
## --label=spec166/ticket-204 --revision=<_doc.revision> --out=<absolute JSON path> on that revision.

const FIXTURES := {
	310: "res://tests/fixtures/characters/hunter_2nd.json",
	320: "res://tests/fixtures/characters/crossbowman_2nd.json",
}


func _load(job: int) -> Dictionary:
	var errors := PackedStringArray()
	var character := DataRepo.load_character(FIXTURES[job], errors)
	assert_eq(errors, PackedStringArray(), "fixture %d loads" % job)
	return character


func test_second_job_fixtures_have_reproducible_provenance() -> void:
	for job: int in FIXTURES:
		var character := _load(job)
		if character.is_empty():
			continue
		assert_eq(int(character.format), CharacterSnapshot.FORMAT)
		assert_eq(int(character.job_id), job)
		assert_between(float(character.level), 30.0, 39.0)
		assert_eq(character.weapon_path, "bow")
		var doc: Dictionary = character._doc
		assert_eq(int(doc.forced_branch), job)
		assert_eq(int(doc.seed), 1)
		assert_eq(doc.policy, "bot")
		assert_eq(DataRepo.canonical_stage_key(String(doc.stage)), "henesys")
		assert_eq(String(doc.revision).length(), 40)
		assert_eq(doc.branch, "spec166/ticket-204")
		assert_eq(doc.outcome, "TIMEOUT")
		assert_eq(float(doc.round_seconds), 600.0)
		assert_eq(doc.invulnerable, true)
		assert_true(String(doc.diagnostic).contains("RunWorld.god"), "invulnerability is documented")
		assert_false(doc.has("exp_mult"), "natural EXP, with no multiplier aid")
		assert_true(character.skills.has("arrow_blow") or character.skills.has("bow_double_shot"), "carried first-job attack")
		assert_true(character.skills.has("arrow_bomb" if job == 310 else "iron_arrow"), "branch attack from advancement draw")
		assert_eq(WeaponInfo.family(int(character.equipment.worn.weapon.id)), "bow" if job == 310 else "crossbow")


func test_fixtures_restore_skills_weapons_and_arrow_tier_and_play_without_warnings() -> void:
	if not require_cache():
		return
	var lib := AssetLibrary.new()
	lib.open()
	for job: int in FIXTURES:
		var character := _load(job)
		if character.is_empty():
			continue
		var missing := PackedStringArray()
		var setup := DataRepo.build_setup(DataRepo.load_all(), "henesys", 2, Vector2(800, 600),
			func(path: String) -> Dictionary: return lib.img(path).root if lib.img(path) != null else {},
			func(id: int) -> Dictionary: return lib.mob_root(id), missing, character)
		assert_eq(interim_missing(missing, setup.data, setup.stage), PackedStringArray())
		var w := RunWorld.new(setup)
		assert_eq(w.progression.job_id, job)
		assert_eq(w.progression.level, int(character.level))
		assert_eq(w.weapon_path, "bow")
		assert_eq(w.weapon_id(), int(character.equipment.worn.weapon.id))
		assert_eq(w.ammo_id(), 2060001 if job == 310 else 2061001, "Bronze arrows derived from restored job, level and weapon")
		for key: String in character.skills:
			assert_eq(w.loadout.rank(key), int(character.skills[key].rank), key)
		for tick in 600:
			w.step(1.0 / 60.0, MoveInput.new())
		assert_eq(w.warnings, PackedStringArray())
	lib.free()
